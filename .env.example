# Shared
# Matches docker-compose defaults — copy this file to .env and fill in OAuth keys
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# OAuth
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vector search (Phase 7 — deferrable)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
GOOGLEAI_API_KEY=""
VECTOR_SIZE=768

# On-demand ISR revalidation (notes app)
REVALIDATE_SECRET="your-revalidate-secret"

# Caching (Phase 8)
REDIS_URL="redis://localhost:6379"

# Stripe (Phase 8 — video app only)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Public key is safe to expose — prefix with NEXT_PUBLIC_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Video app public URL (used for Stripe redirect URLs)
# In production set this to the deployed domain, e.g. https://learn.example.com
NEXT_PUBLIC_APP_URL="http://localhost:3001"
