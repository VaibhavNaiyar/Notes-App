# Shared
# Matches docker-compose defaults — copy this file to .env and fill in OAuth keys
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# OAuth
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vector search (Phase 7 — deferrable)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
GOOGLEAI_API_KEY=""
VECTOR_SIZE=768

# On-demand ISR revalidation (notes app)
REVALIDATE_SECRET="your-revalidate-secret"

# Caching (Phase 8)
REDIS_URL="redis://localhost:6379"
